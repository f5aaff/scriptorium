# Database configuration
DB_PATH=./scriptorium.db
DB_MODE=0600

# Original files and generated derivatives
STORAGE_PATH=./storage

# Keep the application listener private; expose it through an HTTPS reverse proxy.
# For direct LAN-only development, explicitly change this to the LAN interface.
REST_HOST=127.0.0.1
REST_PORT=8080
WEB_ROOT=./web

# First startup only: creates the initial owner account. Use a unique password
# of at least 12 characters. Once the auth file exists these are ignored.
AUTH_FILE=./scriptorium-auth.json
AUTH_USERNAME=
AUTH_PASSWORD=

# Secure cookies are mandatory for HTTPS deployments. For local HTTP-only
# development, set COOKIE_SECURE=false and ALLOW_INSECURE_COOKIES=true together.
# Never disable secure cookies on an internet-facing setup.
COOKIE_SECURE=true
ALLOW_INSECURE_COOKIES=false

# Optional exact origins for a separately hosted/Wails frontend. Leave empty
# for the same-origin browser deployment. Never use wildcard origins.
CORS_ALLOWED_ORIGINS=

# Only set the exact reverse-proxy IPs/CIDRs you control. Leave empty otherwise.
TRUSTED_PROXIES=

# Browser frontend (production uses same-origin API requests)
VITE_API_BASE_URL=
