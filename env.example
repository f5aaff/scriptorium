# Database configuration
DB_PATH=./scriptorium.db
DB_MODE=0600

# Original files and generated derivatives
STORAGE_PATH=./storage

# Bind to all interfaces for LAN access. Use 127.0.0.1 for local-only access.
REST_HOST=0.0.0.0
REST_PORT=8080
WEB_ROOT=./web

# Browser frontend (for Vite development, point this at the backend host)
VITE_API_BASE_URL=http://localhost:8080
